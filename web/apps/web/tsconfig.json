{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // vite.config.ts imports a module of its own with its extension, as Vite's native config loader needs
    "allowImportingTsExtensions": true
  },
  "include": ["src", "build", "vite.config.ts"]
}
