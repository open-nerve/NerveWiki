# 系统与编辑器
.DS_Store
.idea/
.vscode/

# 本地环境变量
.env
.env.*

# 个人本地配置覆盖
config.local.yaml

# 工具产物：Claude Code 的隔离工作区、个人设置与计划任务的状态，Playwright MCP 的截图与快照
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.*
.playwright-mcp/

# 构建与依赖产物。make build 把前端复制进 webui/dist，那里只提交 .gitkeep
/bin/
node_modules/
web/apps/web/dist/
server/internal/platform/webui/dist/*
!server/internal/platform/webui/dist/.gitkeep
coverage/
# 端到端测试的报告、trace、截图与服务日志
e2e/playwright-report/
e2e/test-results/
*.test
*.out
