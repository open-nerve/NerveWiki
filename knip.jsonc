// knip：找出未使用的文件、导出和依赖，是门禁（make knip）。构建产物都在 .gitignore 中，knip 读取 .gitignore，不需要另外忽略。
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // 样例集自检、e2e 换文档的门禁、Playwright 项目配置的检查与收集许可证的脚本的桩由 make lint-web 调用；镜像的第三方许可证由 deploy/Dockerfile 收集；与 Obsidian 的核对、常见密码名单的生成由人手动运行。package.json 的脚本中都看不到
      "entry": [
        "tools/md-fixtures/check.mjs",
        "tools/e2e-navigation/check.mjs",
        "tools/e2e-projects/check.mjs",
        "tools/licenses/check.mjs",
        "tools/licenses/npm.mjs",
        "tools/md-fixtures/obsidian/verify.mjs",
        "tools/md-fixtures/obsidian/verify-resolve.mjs",
        "tools/md-fixtures/obsidian/verify-rename.mjs",
        "tools/md-fixtures/obsidian/verify-render.mjs",
        "tools/md-fixtures/obsidian/verify-export.mjs",
        "tools/password-blocklist/build.mjs",
      ],
    },
    "e2e": {
      // perf/parse/build.ts 按路径载入 web 自己的 Vite 打解析页（M12/P4 设计 4.4）：e2e 不依赖它
      "ignoreDependencies": ["vite"],
    },
    "web/packages/api-client": {
      // 只参与类型检查、不被导入的用例
      "entry": ["test/*.typecheck.ts"],
    },
  },
}
