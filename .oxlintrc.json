{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true
  },
  "rules": {
    // React 17 起的 JSX 自动运行时不需要 React 在作用域内
    "react/react-in-jsx-scope": "off",
    // 样式表只为副作用导入
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "ignorePatterns": ["web/packages/api-client/src/schema.gen.ts", "web/apps/web/dist/**"],
  "overrides": [
    {
      "files": ["tools/**", "web/**/*.config.ts", "e2e/**"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["web/**/src/**", "web/**/test/**", "web/**/public/**"],
      "env": {
        "browser": true
      },
      "rules": {
        // 这些浏览器全局名与局部变量很容易混淆：漏声明一个 name 不会报错，而是读到 window.name。要用时写 window.name
        "no-restricted-globals": [
          "error",
          "name",
          "event",
          "status",
          "length",
          "top",
          "parent",
          "self",
          "close",
          "open"
        ]
      }
    },
    {
      // 只有 services 调用接口，只有会话模块 src/session 创建客户端（测试另建假的）：没有模块级的客户端，
      // 每次登录一代 RootStore，旧一代的客户端不会留在别处（M1/P5 设计 3.2）
      "files": ["web/apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "只有 services 调用接口：组件与 store 经由 service，类型也从 service 导入"
              }
            ],
            "patterns": [{ "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" }]
          }
        ]
      }
    },
    {
      // services 只调用接口：不导入页面、store 与它们的部件（M2/P6 设计 3.2）
      "files": ["web/apps/web/src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "importNames": ["createClient"],
                "message": "只有 src/session 创建客户端，经由 RootStore 交给 service"
              }
            ],
            "patterns": [
              { "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" },
              {
                "group": ["../app/**", "../stores/**", "../pages/**", "../components/**", "../onboarding/**"],
                "message": "service 只调用接口，不依赖页面与 store"
              }
            ]
          }
        ]
      }
    },
    {
      // store 只管理状态：不导入页面与它们的部件；本条重写了上面对整个 src 的限制，所以连同 api-client 一起写
      "files": ["web/apps/web/src/stores/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "只有 services 调用接口：组件与 store 经由 service，类型也从 service 导入"
              }
            ],
            "patterns": [
              { "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" },
              {
                "group": ["../app/**", "../pages/**", "../components/**", "../onboarding/**"],
                "message": "store 只管理状态，不依赖页面"
              }
            ]
          }
        ]
      }
    },
    {
      // lib 是不依赖应用的小工具（名称、类型判断、拖放、卸载提醒等）：编辑器、阅读视图、store 与页面都导入它，
      // 所以它不导入应用的任何一层（M7 收尾 B-N7）；本条重写了上面对整个 src 的限制，所以连同 api-client 一起写
      "files": ["web/apps/web/src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "只有 services 调用接口：组件与 store 经由 service，类型也从 service 导入"
              }
            ],
            "patterns": [
              { "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" },
              {
                "group": [
                  "../app/**",
                  "../stores/**",
                  "../pages/**",
                  "../components/**",
                  "../onboarding/**",
                  "../session/**",
                  "../services/**",
                  "../editor/**",
                  "../reading/**",
                  "../events/**",
                  "../i18n/**"
                ],
                "message": "lib 不依赖应用的任何一层：它被编辑器、阅读视图、store 与页面共用"
              }
            ]
          }
        ]
      }
    },
    {
      // 编辑器与阅读视图的管线只取 services 的类型与 i18n：页面经上下文把它们需要的交进来
      "files": ["web/apps/web/src/editor/**", "web/apps/web/src/reading/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "只有 services 调用接口：组件与 store 经由 service，类型也从 service 导入"
              }
            ],
            "patterns": [
              { "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" },
              {
                "group": [
                  "../app/**",
                  "../stores/**",
                  "../pages/**",
                  "../components/**",
                  "../onboarding/**",
                  "../session/**",
                  "../../app/**",
                  "../../stores/**",
                  "../../pages/**",
                  "../../components/**",
                  "../../onboarding/**",
                  "../../session/**"
                ],
                "message": "编辑器与阅读视图（及 editor/loaded/ 这一层子目录；更深的一层要另补模式）不依赖页面、store 与会话：需要的经上下文交进来"
              }
            ]
          }
        ]
      }
    },
    {
      // 事件流（M5/P3）只经注入的 service 调接口：只取 services 的类型；不依赖页面、store、编辑器与阅读视图；
      // session 只取换代的错误
      "files": ["web/apps/web/src/events/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "只有 services 调用接口：组件与 store 经由 service，类型也从 service 导入"
              },
              {
                "name": "../session/token-manager",
                "allowImportNames": ["SessionChangedError"],
                "message": "事件流只取 session 的 SessionChangedError：连接因换代结束"
              }
            ],
            "patterns": [
              { "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" },
              {
                "group": [
                  "../app/**",
                  "../stores/**",
                  "../pages/**",
                  "../components/**",
                  "../onboarding/**",
                  "../editor/**",
                  "../reading/**"
                ],
                "message": "事件流不依赖页面与 store：hub 由 RootStore 建，事件经 subscribe 交出去"
              },
              {
                "group": ["../services/**"],
                "allowTypeImports": true,
                "message": "事件流只取 services 的类型：EventService 由 RootStore 交进来"
              },
              {
                "group": ["../session/**", "!../session/token-manager", "!../session/testing/**"],
                "message": "事件流只取 session 的 SessionChangedError：连接因换代结束"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["web/apps/web/src/session/**", "web/apps/web/src/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/packages/api-client/**"], "message": "从 @nervewiki/api-client 导入" }] }
        ]
      }
    }
  ]
}
