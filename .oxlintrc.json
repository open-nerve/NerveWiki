{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "oxc", "react", "react-perf", "jsx-a11y"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true
  },
  "rules": {
    // React 17 起的 JSX 自动运行时不需要 React 在作用域内
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "ignorePatterns": ["web/packages/api-client/src/schema.gen.ts", "web/apps/web/dist/**"],
  "overrides": [
    {
      "files": ["tools/**", "web/**/*.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["web/**/src/**", "web/**/test/**"],
      "env": {
        "browser": true
      },
      "rules": {
        // 这些浏览器全局名与局部变量很容易混淆：漏声明一个 name 不会报错，而是读到 window.name。要用时写 window.name
        "no-restricted-globals": [
          "error",
          "name",
          "event",
          "status",
          "length",
          "top",
          "parent",
          "self",
          "close",
          "open"
        ]
      }
    },
    {
      // 组件只经由 store 与 service 使用接口：接口的类型也从 service 取
      "files": ["web/apps/web/src/app/**", "web/apps/web/src/pages/**", "web/apps/web/src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nervewiki/api-client",
                "message": "组件不直接调用接口：经由 stores 与 services，类型从 services 导入"
              }
            ]
          }
        ]
      }
    }
  ]
}
